import discord
from discord.ext import commands
import random

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix='$', intents=intents)

@bot.event
async def on_ready():
    print(f'{bot.user} olarak giriş yaptık')


@bot.command()
async def guess(ctx):
    await ctx.send(f'1 ile 50 arasında bir sayı seçtim, tahmin etmeye çalış!')
    number_to_guess = random.randint(1, 50)

    def check(msg):
        return msg.author == ctx.author and msg.channel == ctx.channel and msg.content.isdigit()

    while True:
        msg = await bot.wait_for('message', check=check)
        user_guess = int(msg.content)  

        if user_guess == number_to_guess:
            await ctx.send(f"🎉Sayıyı doğru bildin!")
        elif user_guess < number_to_guess:
            await ctx.send("Seçtiğim sayı daha büyük!")
        else:
            await ctx.send("Seçtiğim sayı daha küçük!")

bot.run("your_token")
